<?xml version="1.0"?>
<ruleset name="Flux">
    <description>PSR-12 formatting plus the WordPress security, i18n and database checks.</description>

    <rule ref="PSR12">
        <!-- WordPress core and hook callbacks use snake_case method names. -->
        <exclude name="PSR1.Methods.CamelCapsMethodName" />
    </rule>

    <rule ref="Generic.Arrays.DisallowLongArraySyntax" />

    <!-- No padding inside brackets and no alignment padding around operators. -->
    <rule ref="NormalizedArrays.Arrays.ArrayBraceSpacing" />
    <rule ref="Squiz.WhiteSpace.OperatorSpacing">
        <properties>
            <property name="ignoreNewlines" value="true" />
            <property name="ignoreSpacingBeforeAssignments" value="false" />
        </properties>
    </rule>

    <rule ref="WordPress.Security" />
    <rule ref="WordPress.DB">
        <exclude name="WordPress.DB.SlowDBQuery.slow_db_query_meta_query" />
    </rule>
    <rule ref="WordPress.WP.I18n">
        <exclude name="WordPress.WP.I18n.MissingTranslatorsComment" />
    </rule>
</ruleset>
